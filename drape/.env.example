# LIBASS Backend Environment Configuration
# Copy this file to .env and configure your production values

# Flask Secret Key for Session Signing (Set a strong random 64-char string)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Gemini AI API Key for Multimodal Stylist Vision & Suggestions
GEMINI_API_KEY=your_gemini_api_key_here

# Rate Limiting Configuration (Flask-Limiter format)
RATELIMIT_DEFAULT="200 per day;50 per hour"
RATELIMIT_AUTH="10 per minute;30 per hour"
